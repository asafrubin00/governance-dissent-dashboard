{
  "name": "governance-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "data": "python3 scripts/build_dataset.py && python3 scripts/build_leadership_radar.py && python3 scripts/build_market_performance.py && python3 scripts/build_leadership_calibration.py && python3 scripts/validate_leadership_profiles.py && python3 scripts/monitor_issuer_announcements.py",
    "data:radar": "python3 scripts/build_leadership_radar.py && python3 scripts/build_leadership_calibration.py",
    "data:market": "python3 scripts/build_market_performance.py && python3 scripts/build_leadership_calibration.py",
    "data:calibration": "python3 scripts/build_leadership_calibration.py",
    "data:profiles:validate": "python3 scripts/validate_leadership_profiles.py",
    "data:monitor": "python3 scripts/monitor_issuer_announcements.py",
    "data:monitor:baseline": "python3 scripts/monitor_issuer_announcements.py --baseline",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
